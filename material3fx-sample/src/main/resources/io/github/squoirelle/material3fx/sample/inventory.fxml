<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.squoirelle.material3fx.controls.Chip?>
<?import io.github.squoirelle.material3fx.controls.MenuHeader?>
<?import io.github.squoirelle.material3fx.controls.SearchBar?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page, fill-page"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.squoirelle.material3fx.sample.InventoryController">

    <SearchBar fx:id="search" promptText="Search by name, SKU or location"/>

    <!-- Stock chips combine; the category chips, added by the controller, are single-select. -->
    <FlowPane fx:id="filters" styleClass="filters">
        <Chip fx:id="lowFilter" text="Low stock" variant="FILTER"/>
        <Chip fx:id="outFilter" text="Out of stock" variant="FILTER"/>
    </FlowPane>

    <StackPane VBox.vgrow="ALWAYS">
        <TableView fx:id="table" styleClass="striped">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <placeholder><Label text="No item matches the filters."/></placeholder>
            <columns>
                <TableColumn text="Name" prefWidth="220">
                    <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="SKU" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="sku"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Category" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Location" prefWidth="110">
                    <cellValueFactory><PropertyValueFactory property="location"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="90" styleClass="numeric">
                    <cellValueFactory><PropertyValueFactory property="quantity"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="stockColumn" text="Stock" prefWidth="140">
                    <cellValueFactory><PropertyValueFactory property="stock"/></cellValueFactory>
                </TableColumn>
            </columns>
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuHeader title="Item"/>
                        <MenuItem text="Edit" onAction="#editSelected"/>
                        <MenuItem text="Duplicate" onAction="#duplicateSelected"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Delete" onAction="#deleteSelected"/>
                    </items>
                </ContextMenu>
            </contextMenu>
        </TableView>

        <!-- Covers the table while the inventory loads. -->
        <VBox fx:id="loadingOverlay" styleClass="loading-overlay">
            <ProgressIndicator/>
            <Label text="Loading the inventory..." styleClass="body-medium"/>
        </VBox>
    </StackPane>

    <Label fx:id="countLabel" styleClass="body-small, on-surface-variant"/>
</VBox>
